---
import type { CollectionEntry } from 'astro:content';
import { localUrl } from '../data/site';
interface Props { project: CollectionEntry<'projects'>; index: number }
const { project, index } = Astro.props;
const { data } = project;
---
<li class="project-row">
  <a href={localUrl(`/work/${data.slug || project.id}/`)}>
    <span class="project-number meta" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <div class="project-copy">
      <div class="project-label meta">{data.category && <span>{data.category}</span>}{data.example && <span>Example project</span>}</div>
      <h3>{data.title}</h3>
      <p>{data.description}</p>
      {data.technologies.length > 0 && <p class="project-technologies">{data.technologies.join(' / ')}</p>}
    </div>
    <span class="project-end">{data.year && <span class="meta">{data.year}</span>}<span class="project-arrow" aria-hidden="true">↗</span></span>
  </a>
</li>
