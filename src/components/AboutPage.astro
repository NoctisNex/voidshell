---
import Layout from '../layouts/Layout.astro';
import { localUrl } from '../data/site';
import { copy, pageUrl, type Language } from '../data/i18n';
interface Props { language?: Language }
const { language = 'en' } = Astro.props;
const t = copy(language);
---
<Layout language={language} title={t.aboutTitle} description={t.aboutDescription}>
  <div class="page-heading container">
    <p class="eyebrow">{t.aboutEyebrow}</p>
    <h1>{t.aboutHeading[0]}<br />{t.aboutHeading[1]}</h1>
    <p class="page-introduction">{t.aboutIntroduction}</p>
  </div>
  <div class="about-page container">
    <figure class="about-photo">
      <img src={localUrl('/assets/images/robin-800.webp')} srcset={`${localUrl('/assets/images/robin-400.webp')} 400w, ${localUrl('/assets/images/robin-800.webp')} 800w, ${localUrl('/assets/images/robin-1200.webp')} 1200w`} sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1300px) 42vw, 540px" width="800" height="800" alt={t.aboutPortraitAlt} fetchpriority="high" />
      <figcaption>Robin / voidshell</figcaption>
    </figure>
    <div class="about-text">
      <section aria-labelledby="systems-title">
        <h2 id="systems-title">{t.aboutHeadings[0]}</h2>
        <p>{t.aboutParagraphs[0]}</p>
        <p>{t.aboutParagraphs[1]}</p>
        <p>{t.aboutParagraphs[2]}</p>
      </section>
      <section aria-labelledby="troubleshooting-title">
        <h2 id="troubleshooting-title">{t.aboutHeadings[1]}</h2>
        <p>{t.aboutParagraphs[3]}</p>
        <p>{t.aboutParagraphs[4]}</p>
      </section>
      <section aria-labelledby="learning-title">
        <h2 id="learning-title">{t.aboutHeadings[2]}</h2>
        <p>{t.aboutParagraphs[5]}</p>
        <p>{t.aboutParagraphs[6]}</p>
      </section>
      <section aria-labelledby="elsewhere-title">
        <h2 id="elsewhere-title">{t.aboutHeadings[3]}</h2>
        <p>{t.aboutParagraphs[7]}</p>
      </section>
      <section aria-labelledby="currently-title">
        <h2 id="currently-title">{t.aboutHeadings[4]}</h2>
        <p>{t.currentFocus || t.noUpdate}</p>
      </section>
      <a class="text-link" href={pageUrl('/#contact', language)}>{t.getInTouch} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</Layout>
