---
import { site, localUrl } from '../data/site';
import { copy, type Language } from '../data/i18n';
interface Props { language?: Language }
const t = copy(Astro.props.language);
---
<footer class="site-footer container">
  <div class="footer-identity">
    <span class="footer-symbol" aria-hidden="true">
      <img class="logo-light" src={localUrl('/assets/brand/symbol-tiny-black.svg')} width="32" height="32" alt="" />
      <img class="logo-dark" src={localUrl('/assets/brand/symbol-tiny-white.svg')} width="32" height="32" alt="" />
    </span>
    <span>© {new Date().getFullYear()} {site.name}</span>
  </div>
  <label class="theme-control" hidden>
    <span>{t.theme}</span>
    <select id="theme-select" name="theme">
      {['system', 'light', 'dark'].map((value, index) => <option value={value}>{t.themeOptions[index]}</option>)}
    </select>
  </label>
  <a href="#top">{t.backTop} <span aria-hidden="true">↑</span></a>
</footer>
