---
import Layout from '../layouts/Layout.astro';
import ProjectRow from './ProjectRow.astro';
import { copy, pageUrl, type Language } from '../data/i18n';
interface Props { language?: Language }
const { language = 'en' } = Astro.props;
const t = copy(language);
import { site, localUrl } from '../data/site';
import { getProjects } from '../data/projects';
const projects = await getProjects(language);
const profiles = site.profiles.filter(profile => profile.url);
---
<Layout language={language}>
  <section class="hero container" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow">Robin / ICT-Fachmann EFZ</p>
      <h1 id="intro-title">{t.hero[0]}<br />{t.hero[1]}<br /><span>{t.hero[2]}</span></h1>
      <p class="hero-introduction">{t.introduction}</p>
      <p class="job-search">{t.jobSearch}</p>
      <div class="hero-links"><a class="text-link" href="#work">{t.explore} <span aria-hidden="true">↓</span></a>
      <a class="text-link" href={pageUrl('/about/#experience', language)}>{t.experienceLink}</a>
      <a class="text-link" href={pageUrl('/about/#linux', language)}>{t.linux.link}</a></div>
    </div>
    <figure class="hero-portrait">
      <img src={localUrl('/assets/images/robin-800.webp')} srcset={`${localUrl('/assets/images/robin-400.webp')} 400w, ${localUrl('/assets/images/robin-800.webp')} 800w, ${localUrl('/assets/images/robin-1200.webp')} 1200w`} sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 40vw, 432px" width="800" height="800" alt={t.portraitAlt} fetchpriority="high" />
      <figcaption><span>{t.portraitCaption}</span><span>01</span></figcaption>
    </figure>
    <div class="hero-footnote"><span>{t.footnote}</span><span class="meta">{t.collection}</span></div>
  </section>

  <section class="work-section container" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <p class="eyebrow">{t.workLabel}</p>
      <div><h2 id="work-title">{t.workTitle}</h2>
        <p class="section-note">{t.workNote}</p>
        {projects.some(project => project.data.example) && <p class="section-note">{t.exampleWork}</p>}
      </div>
    </div>
    {projects.length ? <ol class="project-list">{projects.map((project, index) => <ProjectRow project={project} index={index} language={language} />)}</ol> : <p class="empty-work">{t.emptyWork}</p>}
  </section>

  <section class="about-strip" aria-labelledby="about-title">
    <div class="container about-grid">
      <p class="eyebrow">{t.aboutLabel}</p>
      <div><h2 id="about-title">{t.aboutTeaserTitle[0]}<br />{t.aboutTeaserTitle[1]}</h2><p>{t.aboutTeaser}</p><a class="text-link" href={pageUrl('/about/', language)}>{t.moreAbout} <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="contact-section container" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">{t.contactLabel}</p>
    <div class="contact-content"><h2 id="contact-title">{t.contactTitle}</h2>
      {site.email ? <a class="contact-email" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a> : <p class="contact-empty">{t.emptyContact}</p>}
      {profiles.length > 0 && <ul class="social-links">{profiles.map(profile => <li><a href={profile.url}>{profile.label} <span aria-hidden="true">↗</span></a></li>)}</ul>}
    </div>
  </section>
</Layout>
